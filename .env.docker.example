# Copy to .env.docker. This file contains no real credentials.
# Single-owner CPU deployment; host model directory must contain bge-m3/.
ENVIRONMENT=production
API_TOKEN=
ZAI_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-4.5-flash
EMBEDDING_BACKEND=huggingface
HF_EMBEDDING_MODEL=/models/bge-m3
BGE_M3_MODEL_PATH=/models/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false
EMBEDDING_MAX_LENGTH=1024
EMBEDDING_BATCH_SIZE=4
EMBEDDING_NORMALIZE=true
EMBEDDING_LOCAL_FILES_ONLY=true
VECTOR_DB_DIR=/app/data/vector_db_domestic_cpu_v3
JOB_COLLECTION_NAME=job_knowledge
CANDIDATE_COLLECTION_NAME=candidate_profile
JOB_RETRIEVAL_STRATEGY=vector
ENABLE_RERANKER=false
DOMESTIC_SYNC_ENABLED=false
MAX_REQUEST_BYTES=10485760
