# Preferred: Zhipu AI GLM (OpenAI-compatible endpoint)
ZAI_API_KEY=
# Optional alias if your platform exports this name
# ZHIPU_API_KEY=your_zhipu_api_key
# ZHIPUAI_API_KEY=your_zhipu_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-4.5-flash
ZHIPU_VISION_MODEL=glm-4.5v

# Optional: OpenAI fallback
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini

APP_HOST=127.0.0.1
APP_PORT=8000

# hash: offline zero-download embedding for quick demo
# huggingface: better semantic quality, needs model download
# Safe zero-download default for a fresh clone. Use `huggingface` for semantic retrieval.
EMBEDDING_BACKEND=hash
HF_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Optional fixed offline path used by the BGE-M3 evaluation candidate.
BGE_M3_MODEL_PATH=
EMBEDDING_DEVICE=auto
EMBEDDING_USE_FP16=false
EMBEDDING_MAX_LENGTH=1024
EMBEDDING_BATCH_SIZE=4
EMBEDDING_NORMALIZE=true
EMBEDDING_LOCAL_FILES_ONLY=false
# Offline demo fallback: EMBEDDING_BACKEND=hash

# Multimodal vector collection
MM_COLLECTION_NAME=multimodal_knowledge
# When changing embedding dimensions, use a new vector directory and collection names;
# never append BGE-M3 vectors to an index created by BGE-small/E5.
# VECTOR_DB_DIR=data/vector_db_bge_m3
# CANDIDATE_COLLECTION_NAME=candidate_profile_bge_m3
# JOB_COLLECTION_NAME=job_knowledge_bge_m3
# EVAL_COLLECTION_NAME=eval_demo_bge_m3

# Reranker settings
ENABLE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATE_K=12
RERANKER_TOP_N=6
RERANKER_LOCAL_FILES_ONLY=true
JOB_RETRIEVAL_STRATEGY=hybrid_rerank
JOB_RETRIEVAL_CANDIDATE_K=12
JOB_RETRIEVAL_RRF_K=60
JOB_RERANKER_WEIGHT=0.2

# Domestic official career-page synchronization. The built-in source list only
# contains reviewed public company career pages; restricted aggregators are excluded.
DOMESTIC_SYNC_ENABLED=false
DOMESTIC_SYNC_INTERVAL_MINUTES=360
DOMESTIC_SYNC_BUILD_INDEX=true
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1200
ZHIPU_DISABLE_THINKING=true
REQUEST_LOG_PATH=data/request_logs/rag_requests.jsonl
OUTPUT_TEXT_ENCODING=utf-8-sig

# Comma-separated Skill names that are active on every Agent request.
# Leave empty to keep domain Skills activated only when the task requires them.
AGENT_ALWAYS_ON_SKILLS=

# Comma-separated Skill names hidden from the Agent and blocked at activation.
AGENT_DISABLED_SKILLS=

# Optional workspace Skill overrides. They are off by default so the repository
# Skill directory remains the production trust root. To approve an override,
# provide its directory, set the flag to true, and list each approved name.
AGENT_WORKSPACE_SKILLS_DIR=
AGENT_ALLOW_WORKSPACE_SKILL_OVERRIDES=false
AGENT_APPROVED_WORKSPACE_SKILLS=
# Deployment boundary
ENVIRONMENT=development
# Set a long random token for any public deployment. When empty, /api routes are unauthenticated.
API_TOKEN=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8501,http://localhost:8501
MAX_REQUEST_BYTES=10485760
